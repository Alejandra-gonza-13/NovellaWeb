@model NovellaWeb.Models.Book

<h1>Add New Book</h1>

<form asp-action="Create" method="post">

    <div>
        <label>Title</label>
        <input asp-for="Title" required />
    </div>

    <div>
        <label>Author</label>
        <input asp-for="Author" required />
    </div>

    <div>
        <label>Description</label>
        <textarea asp-for="Description"></textarea>
    </div>

    <div>
        <label>Genre</label>
        <input asp-for="Genre" />
    </div>

    <div>
        <label>Price</label>
        <input asp-for="Price" type="number" step="0.01" min="0" />
    </div>

    <div>
        <label>Cover URL</label>
        <input asp-for="CoverUrl" />
    </div>

    <div>
        <label>File URL</label>
        <input asp-for="FileUrl" />
    </div>

    <div>
        <label>Available</label>
        <input asp-for="IsAvailable" />
    </div>

    <button type="submit">Add Book</button>

    <a asp-action="Index">Cancel</a>

</form>