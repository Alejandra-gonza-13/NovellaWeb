@model NovellaWeb.Models.Book

@{
    ViewData["Title"] = "Edit Book";
}

<div class="container p-4 rounded"
     style="background-color:#F5F1E7;">

    <h2 style="color:#183E33;">Edit Book</h2>

    <form id="edit-form" data-id="@Model.Id">

        <!-- Display error messages -->
        <div id="error" class="alert alert-danger d-none"></div>

        <!-- Store the book ID -->
        <input asp-for="Id" type="hidden" />

        <!-- Book Information -->
        <h4 class="mt-4" style="color:#183E33;">Book Information</h4>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Author" class="form-label"></label>
            <input asp-for="Author" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"
                      rows="4"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Genre" class="form-label"></label>
            <input asp-for="Genre" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" type="number" step="0.01"
                   min="0" class="form-control" />
        </div>

        <!-- Digital Assets -->
        <h4 class="mt-4" style="color:#183E33;">Digital Assets</h4>

        <!-- Display the current book cover -->
        <div class="mb-3">
            <label class="form-label">Current Book Cover</label>
            <div>
                <img id="current-image" class="d-none rounded"
                     style="height:150px;" alt="Current book cover" />
            </div>
        </div>

        <!-- Upload a new cover only if needed -->
        <div class="mb-3">
            <label class="form-label">New Book Cover (optional)</label>
            <input type="file" name="cover"
                   accept="image/*" class="form-control" />
        </div>

        <!-- Book Availability -->
        <div class="mb-3 form-check">
            <input asp-for="IsAvailable" class="form-check-input" />
            <label asp-for="IsAvailable" class="form-check-label">
                Available
            </label>
        </div>

        <!-- Form Buttons -->
        <button type="submit" class="btn text-white"
                style="background-color:#183E33;">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-link">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    <script type="module"
            src="~/js/book-edit.js"
            asp-append-version="true"></script>
}
