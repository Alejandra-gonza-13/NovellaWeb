@model NovellaWeb.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<!-- Delete Book page -->
<div class="container p-4 rounded"
     style="background-color:#F5F1E7;">

    <h2 style="color:#183E33;">Delete Book</h2>

    <!-- Display error messages -->
    <div id="error" class="alert alert-danger d-none"></div>

    <!-- Delete confirmation message -->
    <p class="mt-4">
        Are you sure you want to delete
        <strong id="product-name"></strong>?
    </p>

    <!-- Display the current book cover -->
    <img id="current-image"
         class="d-none mb-3 rounded"
         style="height:150px;"
         alt="Book cover" />

    <!-- Delete form -->
    <form id="delete-form" data-id="@Model.Id">

        <button type="submit" class="btn btn-danger">
            Delete Book
        </button>

        <a asp-action="Index" class="btn btn-link"
           style="color:#183E33;">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    <!-- JavaScript to delete the book from Firebase -->
    <script type="module"
            src="~/js/book-delete.js"
            asp-append-version="true"></script>
}
