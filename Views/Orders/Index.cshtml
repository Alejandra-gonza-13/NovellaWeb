@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container py-4">

    <h2 style="color: #183E33; font-family: Georgia;">
        Manage Orders
    </h2>

    <p class="text-muted">
        View and manage customer orders.
    </p>

    <div class="card p-3" style="background-color: #F5F1E7;">

        <div class="table-responsive">
            <table class="table align-middle">

                <thead>
                    <tr style="color: #183E33;">
                        <th>Order ID</th>
                        <th>Customer Email</th>
                        <th>Order Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="orders-list">
                    <tr>
                        <td colspan="6" class="text-center">
                            Loading orders...
                        </td>
                    </tr>
                </tbody>

            </table>
        </div>

    </div>

    <div id="orders-error"
         class="alert alert-danger d-none mt-3">
    </div>

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn mt-3"
       style="background-color: #183E33; color: white;">
        Back to Dashboard
    </a>

</div>

@section Scripts {
    <script type="module"
            src="~/js/admin-orders.js"
            asp-append-version="true"></script>
}
