@model IEnumerable<NovellaWeb.Models.Order>

@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container py-4">

    <h2 style="color: #183E33; font-family: Georgia;">
        Manage Orders
    </h2>

    <p class="text-muted">
        View and manage customer orders.
    </p>

    <div class="card p-3" style="background-color: #F5F1E7;">

        <table class="table align-middle">

            <thead style="background-color: #183E33; color: white;">
                <tr>
                    <th>Order ID</th>
                    <th>Customer Email</th>
                    <th>Order Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>

                        <td>@order.CustomerEmail</td>

                        <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>

                        <td>$@order.Total.ToString("F2")</td>

                        <td>
                            @if (order.Status == "Paid")
                            {
                                <span class="badge"
                                      style="background-color: #183E33;">
                                    Paid
                                </span>
                            }
                            else
                            {
                                <span class="badge"
                                      style="background-color: #BD964F; color: #222222;">
                                    @order.Status
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@order.Id"
                               class="btn btn-sm"
                               style="background-color: #183E33; color: white;">
                                Details
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn mt-3"
       style="background-color: #183E33; color: white;">
        Back to Dashboard
    </a>

</div>