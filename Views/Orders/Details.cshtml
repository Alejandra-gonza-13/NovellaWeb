@{
    ViewData["Title"] = "Order Details";
}

<div class="container py-4"
     id="order-details"
     data-order-id="@ViewBag.OrderId">

    <h2 style="color: #183E33; font-family: Georgia;">
        Order Details
    </h2>

    <p class="text-muted">
        View customer order information.
    </p>

    <div id="order-error"
         class="alert alert-danger d-none">
    </div>

    <div class="card p-4"
         style="background-color: #F5F1E7;">

        <h4 id="order-title" style="color: #183E33;">
            Loading order...
        </h4>

        <hr />

        <!-- Order information -->
        <dl class="row">

            <dt class="col-sm-4">Order ID</dt>
            <dd class="col-sm-8" id="order-id"></dd>

            <dt class="col-sm-4">Customer ID</dt>
            <dd class="col-sm-8" id="customer-id"></dd>

            <dt class="col-sm-4">Customer Email</dt>
            <dd class="col-sm-8" id="customer-email"></dd>

            <dt class="col-sm-4">Order Date</dt>
            <dd class="col-sm-8" id="order-date"></dd>

            <dt class="col-sm-4">Total</dt>
            <dd class="col-sm-8" id="order-total"></dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                <span id="order-status" class="badge"></span>
            </dd>

        </dl>

        <hr />

        <!-- Purchased books -->
        <h4 style="color: #183E33;">
            Purchased Books
        </h4>

        <div id="order-items" class="mt-3">
            Loading books...
        </div>

    </div>

    <a asp-controller="Orders"
       asp-action="Index"
       class="btn mt-3"
       style="background-color: #183E33; color: white;">
        Back to Orders
    </a>

</div>

@section Scripts {
    <script type="module"
            src="~/js/order-details.js"
            asp-append-version="true"></script>
}
