@model NovellaWeb.Models.DashboardViewModel

<h1>Admin Dashboard</h1>

<hr />

<h2>Overview</h2>

<div>
    <h3>Total Revenue</h3>
    <p>$@Model.TotalRevenue.ToString("F2")</p>
</div>

<div>
    <h3>Total Books</h3>
    <p>@Model.TotalBooks</p>
</div>

<div>
    <h3>Total Orders</h3>
    <p>@Model.TotalOrders</p>
</div>

<div>
    <h3>Total Customers</h3>
    <p>@Model.TotalCustomers</p>
</div>

<hr />

<h2>Monthly Sales</h2>

@if (Model.MonthlySales.Count == 0)
{
    <p>No sales yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Month</th>
                <th>Revenue</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var sale in Model.MonthlySales)
            {
                <tr>
                    <td>@sale.Month</td>
                    <td>$@sale.Revenue.ToString("F2")</td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<h2>Best-selling Books</h2>

@if (Model.BestSellingBooks.Count == 0)
{
    <p>No purchases yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Book Title</th>
                <th>Quantity Sold</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var book in Model.BestSellingBooks)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.QuantitySold</td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<h2>Management</h2>

<div>
    <a asp-controller="Books" asp-action="Index">
        Manage Books
    </a>
</div>

<div>
    <p>Manage Orders - Coming soon</p>
</div>

<div>
    <p>Manage Users - Coming soon</p>
</div>