@model NovellaWeb.Models.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4" style="background-color: #F5F1E7;">

    <h1 style="color: #183E33; font-family: Georgia;">
        Admin Dashboard
    </h1>

    <p class="text-muted">Overview of your bookstore.</p>

    <hr />

    <h2 style="color: #183E33;">Overview</h2>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card p-3 h-100">
                <h5 style="color: #183E33;">Total Revenue</h5>
                <h3>$@Model.TotalRevenue.ToString("F2")</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 h-100">
                <h5 style="color: #183E33;">Total Books</h5>
                <h3>@Model.TotalBooks</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 h-100">
                <h5 style="color: #183E33;">Total Orders</h5>
                <h3>@Model.TotalOrders</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 h-100">
                <h5 style="color: #183E33;">Total Customers</h5>
                <h3>@Model.TotalCustomers</h3>
            </div>
        </div>

    </div>

    <div class="card p-4 mb-4">

        <h3 style="color: #183E33;">Monthly Sales</h3>

        @if (Model.MonthlySales.Count == 0)
        {
            <p>No sales yet.</p>
        }
        else
        {
            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Month</th>
                        <th>Revenue</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var sale in Model.MonthlySales)
                    {
                        <tr>
                            <td>@sale.Month</td>
                            <td>$@sale.Revenue.ToString("F2")</td>
                        </tr>
                    }
                </tbody>

            </table>
        }

    </div>

    <div class="card p-4 mb-4">

        <h3 style="color: #183E33;">Best-selling Books</h3>

        @if (Model.BestSellingBooks.Count == 0)
        {
            <p>No purchases yet.</p>
        }
        else
        {
            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Book Title</th>
                        <th>Quantity Sold</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var book in Model.BestSellingBooks)
                    {
                        <tr>
                            <td>@book.Title</td>
                            <td>@book.QuantitySold</td>
                        </tr>
                    }
                </tbody>

            </table>
        }

    </div>

    <h2 style="color: #183E33;">Management</h2>

    <div class="row g-3">

        <div class="col-md-4">
            <div class="card p-3 h-100">

                <h4 style="color: #183E33;">Manage Books</h4>

                <p>Add, edit and delete books.</p>

                <a asp-controller="Books"
                   asp-action="Index"
                   class="btn"
                   style="background-color: #183E33; color: white;">
                    Manage Books
                </a>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 h-100">

                <h4 style="color: #183E33;">Manage Orders</h4>

                <p>View customer orders and details.</p>

                <a asp-controller="Orders"
                   asp-action="Index"
                   class="btn"
                   style="background-color: #183E33; color: white;">
                    Manage Orders
                </a>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 h-100">

                <h4 style="color: #183E33;">Manage Users</h4>

                <p>View customer information.</p>

                <button class="btn"
                        style="background-color: #BD964F;"
                        disabled>
                    Coming soon
                </button>

            </div>
        </div>

    </div>

</div>